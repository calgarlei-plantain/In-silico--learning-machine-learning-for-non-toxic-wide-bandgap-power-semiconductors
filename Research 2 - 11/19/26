        "import json, os\n",
        "from pathlib import Path\n",
        "\n",
        "import pandas as pd\n",
        "from mp_api.client import MPRester\n",
        "from pymatgen.core import Structure\n",
        "\n",
        "OUT = Path(\"mp_summary\")\n",
        "files = sorted(OUT.glob(\"batch_*.parquet\"))\n",
        "print(len(files), \"batch files saved\")\n",
        "print((OUT / \"db_version.txt\").read_text())\n",
        "print(\"A failed batch was recorded:\", (OUT / \"failed_batch.txt\").exists())\n",
        "\n",
        "df = pd.concat([pd.read_parquet(f) for f in files], ignore_index=True)\n",
        "\n",
        "with MPRester(os.environ[\"MP_API_KEY\"]) as mpr:\n",
        "    total = mpr.materials.summary.count()\n",
        "\n",
        "# Check 1: the row count matches what the database has\n",
        "print(f\"Check 1 (row count): {len(df)} saved, {total} in the database ->\", \"PASS\" if len(df) == total else \"FAIL\")\n",
        "\n",
        "# Check 2: every material_id is unique\n",
        "n_dup = df[\"material_id\"].duplicated().sum()\n",
        "print(f\"Check 2 (unique IDs): {n_dup} duplicate IDs ->\", \"PASS\" if n_dup == 0 else \"FAIL\")\n",
        "\n",
        "# Check 3: every structure loads without error\n",
        "bad = []\n",
        "for mid, s in zip(df[\"material_id\"], df[\"structure\"]):\n",
        "    try:\n",
        "        Structure.from_dict(json.loads(s))\n",
        "    except Exception:\n",
        "        bad.append(mid)\n",
        "print(f\"Check 3 (structures load): {len(bad)} failed ->\", \"PASS\" if not bad else \"FAIL\")\n",
        "if bad:\n",
        "    print(bad[:10])"
      ],
